generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationType {
  INDIVIDUAL
  BUSINESS
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MemberRole {
  OWNER
  MANAGER
  MEMBER
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  emailVerifiedAt    DateTime?
  status             UserStatus           @default(ACTIVE)
  globalRole         GlobalRole           @default(CUSTOMER)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  memberships        OrganizationMember[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  mfa                MfaCredential?
  recoveryCodes      MfaRecoveryCode[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  carts              Cart[]
  domainSearches     DomainSearchLog[]

  @@index([status, globalRole])
}

model Organization {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  slug      String               @unique
  type      OrganizationType
  taxId     String?
  country   String               @default("CV")
  status    OrganizationStatus   @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   OrganizationMember[]
  auditLogs AuditLog[]

  @@index([status])
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           MemberRole   @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  csrfHash    String
  mfaVerified Boolean   @default(false)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  userAgent   String?
  ipAddress   String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model VerificationToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  purpose    TokenPurpose
  tokenHash  String       @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model MfaCredential {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  type            String    @default("TOTP")
  encryptedSecret String
  enabledAt       DateTime?
  lastUsedStep    BigInt?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MfaRecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String    @unique
  consumedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  actorUserId    String?       @db.Uuid
  organizationId String?       @db.Uuid
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json          @default("{}")
  ipAddress      String?
  createdAt      DateTime      @default(now())
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
}

model Notification {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @db.Uuid
  type             String
  subject          String
  /// Reserved for future non-credential notification content. Phase 1 leaves it null.
  encryptedPayload String?
  status           NotificationStatus @default(PENDING)
  createdAt        DateTime           @default(now())
  sentAt           DateTime?
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

enum RegistrarStatus {
  ACTIVE
  DISABLED
}

enum DomainOperation {
  REGISTER
  TRANSFER
  RENEW
}

enum MarginType {
  FIXED
  MARKUP
  GROSS_MARGIN
}

enum CartStatus {
  OPEN
  MERGED
  EXPIRED
}

model Registrar {
  id                     String          @id @default(uuid()) @db.Uuid
  code                   String          @unique
  name                   String
  status                 RegistrarStatus @default(DISABLED)
  configurationReference String
  lastSyncedAt           DateTime?
  lastErrorCode          String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  tlds                   TldRegistrar[]
  prices                 TldPrice[]
}

model Tld {
  id          String         @id @default(uuid()) @db.Uuid
  extension   String         @unique
  displayName String
  isActive    Boolean        @default(false)
  isFeatured  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  registrars  TldRegistrar[]
  prices      TldPrice[]
  cartItems   CartItem[]
}

model TldRegistrar {
  id                   String    @id @default(uuid()) @db.Uuid
  tldId                String    @db.Uuid
  registrarId          String    @db.Uuid
  isActive             Boolean   @default(false)
  priority             Int       @default(100)
  supportsRegistration Boolean   @default(false)
  supportsTransfer     Boolean   @default(false)
  supportsRenewal      Boolean   @default(false)
  minimumPeriod        Int       @default(1)
  maximumPeriod        Int       @default(10)
  idnScript            String?
  lastSyncedAt         DateTime?
  tld                  Tld       @relation(fields: [tldId], references: [id], onDelete: Cascade)
  registrar            Registrar @relation(fields: [registrarId], references: [id], onDelete: Restrict)

  @@unique([tldId, registrarId])
  @@index([registrarId, isActive])
}

model TldPrice {
  id                     String          @id @default(uuid()) @db.Uuid
  tldId                  String          @db.Uuid
  registrarId            String          @db.Uuid
  operation              DomainOperation @default(REGISTER)
  periodYears            Int
  supplierCurrency       String
  currency               String          @default("CVE")
  supplierCostMinor      BigInt
  sellingPriceMinor      BigInt
  marginType             MarginType
  marginValue            Decimal         @db.Decimal(20, 8)
  minimumPriceMinor      BigInt          @default(0)
  additionalCostMinor    BigInt          @default(0)
  roundingIncrementMinor BigInt          @default(1)
  isActive               Boolean         @default(true)
  effectiveFrom          DateTime        @default(now())
  effectiveUntil         DateTime
  updatedAt              DateTime        @updatedAt
  tld                    Tld             @relation(fields: [tldId], references: [id], onDelete: Restrict)
  registrar              Registrar       @relation(fields: [registrarId], references: [id], onDelete: Restrict)

  @@index([tldId, registrarId, operation, periodYears, isActive])
}

model ExchangeRate {
  id             String   @id @default(uuid()) @db.Uuid
  baseCurrency   String
  targetCurrency String
  rate           Decimal  @db.Decimal(30, 16)
  source         String
  fetchedAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([baseCurrency, targetCurrency, expiresAt])
}

model DomainSearchLog {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @db.Uuid
  normalizedQuery String
  extension       String
  registrarCode   String
  status          String
  isPremium       Boolean  @default(false)
  cacheHit        Boolean
  responseTimeMs  Int
  errorCode       String?
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([extension, createdAt])
}

model Cart {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String?    @unique @db.Uuid
  sessionIdentifier String?    @unique
  csrfHash          String?
  status            CartStatus @default(OPEN)
  currency          String     @default("CVE")
  expiresAt         DateTime
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             CartItem[]

  @@index([status, expiresAt])
}

model CartItem {
  id                String          @id @default(uuid()) @db.Uuid
  cartId            String          @db.Uuid
  domainName        String
  tldId             String          @db.Uuid
  registrarCode     String
  operation         DomainOperation @default(REGISTER)
  registrationYears Int
  unitPriceMinor    BigInt
  currency          String
  isPremium         Boolean         @default(false)
  quoteExpiresAt    DateTime
  priceSnapshot     Json
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  tld               Tld             @relation(fields: [tldId], references: [id], onDelete: Restrict)

  @@unique([cartId, domainName, operation])
}
