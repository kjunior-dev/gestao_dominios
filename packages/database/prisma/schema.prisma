generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationType {
  INDIVIDUAL
  BUSINESS
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MemberRole {
  OWNER
  MANAGER
  MEMBER
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  emailVerifiedAt    DateTime?
  status             UserStatus           @default(ACTIVE)
  globalRole         GlobalRole           @default(CUSTOMER)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  memberships        OrganizationMember[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  mfa                MfaCredential?
  recoveryCodes      MfaRecoveryCode[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  carts              Cart[]
  domainSearches     DomainSearchLog[]
  orders             Order[]

  @@index([status, globalRole])
}

model Organization {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  slug      String               @unique
  type      OrganizationType
  taxId     String?
  country   String               @default("CV")
  status    OrganizationStatus   @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   OrganizationMember[]
  auditLogs AuditLog[]
  orders    Order[]
  contacts  DomainContact[]
  domains   ManagedDomain[]
  billing   BillingProfile?

  @@index([status])
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           MemberRole   @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  csrfHash    String
  mfaVerified Boolean   @default(false)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  userAgent   String?
  ipAddress   String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model VerificationToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  purpose    TokenPurpose
  tokenHash  String       @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model MfaCredential {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  type            String    @default("TOTP")
  encryptedSecret String
  enabledAt       DateTime?
  lastUsedStep    BigInt?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MfaRecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String    @unique
  consumedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  actorUserId    String?       @db.Uuid
  organizationId String?       @db.Uuid
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json          @default("{}")
  ipAddress      String?
  createdAt      DateTime      @default(now())
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
}

model Notification {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @db.Uuid
  type             String
  subject          String
  /// Reserved for future non-credential notification content. Phase 1 leaves it null.
  encryptedPayload String?
  status           NotificationStatus @default(PENDING)
  createdAt        DateTime           @default(now())
  sentAt           DateTime?
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

enum RegistrarStatus {
  ACTIVE
  DISABLED
}

enum DomainOperationKind {
  REGISTER
  TRANSFER
  RENEW

  @@map("DomainOperation")
}

enum MarginType {
  FIXED
  MARKUP
  GROSS_MARGIN
}

enum CartStatus {
  OPEN
  MERGED
  EXPIRED
}

model Registrar {
  id                     String                    @id @default(uuid()) @db.Uuid
  code                   String                    @unique
  name                   String
  status                 RegistrarStatus           @default(DISABLED)
  configurationReference String
  lastSyncedAt           DateTime?
  lastErrorCode          String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  tlds                   TldRegistrar[]
  prices                 TldPrice[]
  registrations          DomainRegistration[]
  contactMappings        RegistrarContactMapping[]
}

model Tld {
  id          String         @id @default(uuid()) @db.Uuid
  extension   String         @unique
  displayName String
  isActive    Boolean        @default(false)
  isFeatured  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  registrars  TldRegistrar[]
  prices      TldPrice[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model TldRegistrar {
  id                   String    @id @default(uuid()) @db.Uuid
  tldId                String    @db.Uuid
  registrarId          String    @db.Uuid
  isActive             Boolean   @default(false)
  priority             Int       @default(100)
  supportsRegistration Boolean   @default(false)
  supportsTransfer     Boolean   @default(false)
  supportsRenewal      Boolean   @default(false)
  minimumPeriod        Int       @default(1)
  maximumPeriod        Int       @default(10)
  registrationPolicy   Json      @default("{}")
  idnScript            String?
  lastSyncedAt         DateTime?
  tld                  Tld       @relation(fields: [tldId], references: [id], onDelete: Cascade)
  registrar            Registrar @relation(fields: [registrarId], references: [id], onDelete: Restrict)

  @@unique([tldId, registrarId])
  @@index([registrarId, isActive])
}

model TldPrice {
  id                     String              @id @default(uuid()) @db.Uuid
  tldId                  String              @db.Uuid
  registrarId            String              @db.Uuid
  operation              DomainOperationKind @default(REGISTER)
  periodYears            Int
  supplierCurrency       String
  currency               String              @default("CVE")
  supplierCostMinor      BigInt
  sellingPriceMinor      BigInt
  marginType             MarginType
  marginValue            Decimal             @db.Decimal(20, 8)
  minimumPriceMinor      BigInt              @default(0)
  additionalCostMinor    BigInt              @default(0)
  roundingIncrementMinor BigInt              @default(1)
  isActive               Boolean             @default(true)
  effectiveFrom          DateTime            @default(now())
  effectiveUntil         DateTime
  updatedAt              DateTime            @updatedAt
  tld                    Tld                 @relation(fields: [tldId], references: [id], onDelete: Restrict)
  registrar              Registrar           @relation(fields: [registrarId], references: [id], onDelete: Restrict)

  @@index([tldId, registrarId, operation, periodYears, isActive])
}

model ExchangeRate {
  id             String   @id @default(uuid()) @db.Uuid
  baseCurrency   String
  targetCurrency String
  rate           Decimal  @db.Decimal(30, 16)
  source         String
  fetchedAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([baseCurrency, targetCurrency, expiresAt])
}

model DomainSearchLog {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @db.Uuid
  normalizedQuery String
  extension       String
  registrarCode   String
  status          String
  isPremium       Boolean  @default(false)
  cacheHit        Boolean
  responseTimeMs  Int
  errorCode       String?
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([extension, createdAt])
}

model Cart {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String?    @unique @db.Uuid
  sessionIdentifier String?    @unique
  csrfHash          String?
  status            CartStatus @default(OPEN)
  currency          String     @default("CVE")
  expiresAt         DateTime
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             CartItem[]

  @@index([status, expiresAt])
}

model CartItem {
  id                String              @id @default(uuid()) @db.Uuid
  cartId            String              @db.Uuid
  domainName        String
  tldId             String              @db.Uuid
  registrarCode     String
  operation         DomainOperationKind @default(REGISTER)
  registrationYears Int
  unitPriceMinor    BigInt
  currency          String
  isPremium         Boolean             @default(false)
  quoteExpiresAt    DateTime
  priceSnapshot     Json
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  cart              Cart                @relation(fields: [cartId], references: [id], onDelete: Cascade)
  tld               Tld                 @relation(fields: [tldId], references: [id], onDelete: Restrict)

  @@unique([cartId, domainName, operation])
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  PROVISIONING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  MANUAL_REVIEW
}

enum TransactionEnvironment {
  MOCK
  SANDBOX
  LIVE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  DECLINED
  CANCELLED
  UNKNOWN
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RegistrationStatus {
  READY
  SUBMITTED
  PENDING
  UNKNOWN
  COMPLETED
  FAILED
  MANUAL_REVIEW
  BLOCKED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  UNKNOWN
}

model BillingProfile {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @db.Uuid
  legalName      String
  taxId          String?
  address        String
  city           String
  postalCode     String
  countryCode    String
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model Order {
  id              String                 @id @default(uuid()) @db.Uuid
  orderNumber     String                 @unique
  organizationId  String                 @db.Uuid
  customerId      String                 @db.Uuid
  status          OrderStatus            @default(PENDING_PAYMENT)
  environment     TransactionEnvironment @default(MOCK)
  idempotencyKey  String
  requestHash     String
  subtotalMinor   BigInt
  feesMinor       BigInt                 @default(0)
  discountMinor   BigInt                 @default(0)
  taxMinor        BigInt                 @default(0)
  totalMinor      BigInt
  currency        String                 @default("CVE")
  billingSnapshot Json
  termsVersion    String
  termsAcceptedAt DateTime
  expiresAt       DateTime
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  customer        User                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  payments        Payment[]
  invoices        Invoice[]
  transitions     OrderTransition[]

  @@unique([customerId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                String              @id @default(uuid()) @db.Uuid
  orderId           String              @db.Uuid
  tldId             String              @db.Uuid
  domainContactId   String              @db.Uuid
  domainName        String
  operation         DomainOperationKind @default(REGISTER)
  registrationYears Int
  supplierCostMinor BigInt
  supplierCurrency  String
  salePriceMinor    BigInt
  currency          String
  quoteSnapshot     Json
  nameservers       Json
  isPremium         Boolean             @default(false)
  premiumAccepted   Boolean             @default(false)
  status            RegistrationStatus  @default(READY)
  createdAt         DateTime            @default(now())
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  tld               Tld                 @relation(fields: [tldId], references: [id], onDelete: Restrict)
  contact           DomainContact       @relation(fields: [domainContactId], references: [id], onDelete: Restrict)
  registration      DomainRegistration?
  operations        DomainOperation[]

  @@unique([orderId, domainName])
}

model OrderTransition {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @db.Uuid
  fromStatus  OrderStatus
  toStatus    OrderStatus
  reason      String
  actorUserId String?     @db.Uuid
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model Payment {
  id                String                 @id @default(uuid()) @db.Uuid
  orderId           String                 @db.Uuid
  provider          String
  providerPaymentId String?                @unique
  amountMinor       BigInt
  currency          String
  environment       TransactionEnvironment
  status            PaymentStatus          @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events            PaymentEvent[]
  refunds           Refund[]

  @@unique([orderId, provider])
  @@index([status, createdAt])
}

model PaymentEvent {
  id              String    @id @default(uuid()) @db.Uuid
  paymentId       String    @db.Uuid
  provider        String
  providerEventId String
  eventType       String
  verified        Boolean
  payloadHash     String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([processedAt, createdAt])
}

model DomainContact {
  id               String                    @id @default(uuid()) @db.Uuid
  organizationId   String                    @db.Uuid
  firstName        String
  lastName         String
  companyName      String?
  email            String
  phone            String
  phoneCountryCode String
  address          String
  addressNumber    String
  city             String
  region           String?
  postalCode       String
  countryCode      String
  contactType      String                    @default("OWNER")
  createdAt        DateTime                  @default(now())
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  mappings         RegistrarContactMapping[]
  items            OrderItem[]

  @@index([organizationId])
}

model RegistrarContactMapping {
  id              String             @id @default(uuid()) @db.Uuid
  registrarId     String             @db.Uuid
  domainContactId String             @db.Uuid
  externalHandle  String?
  status          RegistrationStatus @default(READY)
  createdAt       DateTime           @default(now())
  registrar       Registrar          @relation(fields: [registrarId], references: [id], onDelete: Restrict)
  contact         DomainContact      @relation(fields: [domainContactId], references: [id], onDelete: Restrict)

  @@unique([registrarId, domainContactId])
}

model DomainRegistration {
  id                     String             @id @default(uuid()) @db.Uuid
  orderItemId            String             @unique @db.Uuid
  domainId               String?            @unique @db.Uuid
  registrarId            String             @db.Uuid
  externalRegistrationId String?
  status                 RegistrationStatus @default(READY)
  attemptCount           Int                @default(0)
  idempotencyKey         String             @unique
  lastErrorCode          String?
  requestedAt            DateTime           @default(now())
  completedAt            DateTime?
  item                   OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  registrar              Registrar          @relation(fields: [registrarId], references: [id], onDelete: Restrict)
  domain                 ManagedDomain?     @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@unique([registrarId, externalRegistrationId])
  @@index([status, requestedAt])
}

model ManagedDomain {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  domainName     String
  environment    TransactionEnvironment
  status         String
  registeredAt   DateTime?
  expiresAt      DateTime?
  createdAt      DateTime               @default(now())
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  registration   DomainRegistration?

  @@unique([domainName, environment])
  @@index([organizationId])
}

model DomainOperation {
  id                String             @id @default(uuid()) @db.Uuid
  orderItemId       String             @db.Uuid
  operationType     String
  status            RegistrationStatus @default(READY)
  idempotencyKey    String             @unique
  externalReference String?
  attemptCount      Int                @default(0)
  lastError         String?
  createdAt         DateTime           @default(now())
  completedAt       DateTime?
  item              OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("DomainExecution")
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @db.Uuid
  invoiceNumber String   @unique
  status        String   @default("INTERNAL")
  subtotalMinor BigInt
  taxMinor      BigInt
  totalMinor    BigInt
  currency      String
  issuedAt      DateTime
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @db.Uuid
  idempotencyKey   String
  amountMinor      BigInt
  currency         String
  reason           String
  status           RefundStatus @default(REQUESTED)
  providerRefundId String?      @unique
  requestedBy      String       @db.Uuid
  approvedBy       String?      @db.Uuid
  approvedAt       DateTime?
  createdAt        DateTime     @default(now())
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, idempotencyKey])
  @@index([status, createdAt])
}

model CommerceOutbox {
  id               String    @id @default(uuid()) @db.Uuid
  topic            String
  deduplicationKey String    @unique
  payload          Json
  publishedAt      DateTime?
  completedAt      DateTime?
  attempts         Int       @default(0)
  lastErrorCode    String?
  createdAt        DateTime  @default(now())

  @@index([publishedAt, createdAt])
}

model LiveApproval {
  id                String    @id @default(uuid()) @db.Uuid
  requestedBy       String    @db.Uuid
  approvedBy        String?   @db.Uuid
  reason            String
  configurationHash String
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([expiresAt, revokedAt])
}
