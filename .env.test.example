NODE_ENV=test
API_PORT=4400
DATABASE_URL=postgresql://devtrust:devtrust_local@localhost:5432/devtrust_test
REDIS_URL=redis://localhost:6379/1
APP_URL=http://localhost:3300
API_INTERNAL_URL=http://localhost:4400
TOTP_ENCRYPTION_KEY=
DEV_MAILBOX_DIR=/tmp/devtrust-test-mailbox
SESSION_TTL_HOURS=168

OPENPROVIDER_ENABLED=false
OPENPROVIDER_BASE_URL=https://api.openprovider.eu/v1
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
OPENPROVIDER_TIMEOUT_MS=10000
OPENPROVIDER_TOKEN_TTL_SECONDS=3600
OPENPROVIDER_REQUESTS_PER_MINUTE=60
DOMAIN_CACHE_ENABLED=true
DOMAIN_AVAILABLE_TTL_SECONDS=60
DOMAIN_UNAVAILABLE_TTL_SECONDS=300
DOMAIN_SEARCHES_PER_MINUTE=20
DOMAIN_LOG_RETENTION_DAYS=30
CART_TTL_HOURS=72
QUOTE_TTL_SECONDS=300
EXCHANGE_RATE_PROVIDER=manual

# Phase 3: live transactions are disabled by default
PAYMENTS_MODE=mock
DOMAIN_REGISTRATION_MODE=mock
LIVE_TRANSACTIONS_ENABLED=false
BILLING_MODE=internal
EMAIL_MODE=development
BILLING_TAX_BASIS_POINTS=0
CHECKOUT_TERMS_VERSION=devtrust-internal-2026-10

# Only after validating the official sandbox contract; never enabled by credentials alone.
OPENPROVIDER_SANDBOX_CONTRACT_VERIFIED=false
