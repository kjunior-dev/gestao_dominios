{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_INTERNAL_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "REDIS_URL",
        "APP_URL",
        "API_INTERNAL_URL",
        "API_PORT",
        "WEB_PORT",
        "TOTP_ENCRYPTION_KEY",
        "SESSION_TTL_HOURS",
        "DEV_MAILBOX_DIR",
        "OPENPROVIDER_*",
        "DOMAIN_*",
        "CART_TTL_HOURS",
        "QUOTE_TTL_SECONDS",
        "EXCHANGE_RATE_PROVIDER"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
