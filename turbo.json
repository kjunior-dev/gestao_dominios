{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        ".next-build/**",
        "!.next-build/cache/**"
      ],
      "env": ["API_INTERNAL_URL", "NEXT_OUTPUT_DIR"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "REDIS_URL",
        "APP_URL",
        "API_INTERNAL_URL",
        "API_PORT",
        "WEB_PORT",
        "TOTP_ENCRYPTION_KEY",
        "SESSION_TTL_HOURS",
        "DEV_MAILBOX_DIR",
        "OPENPROVIDER_*",
        "DOMAIN_*",
        "CART_TTL_HOURS",
        "QUOTE_TTL_SECONDS",
        "EXCHANGE_RATE_PROVIDER",
        "PAYMENTS_MODE",
        "LIVE_TRANSACTIONS_ENABLED",
        "DOMAIN_REGISTRATION_MODE",
        "BILLING_MODE",
        "EMAIL_MODE",
        "MOCK_WEBHOOK_SECRET",
        "BILLING_TAX_BASIS_POINTS",
        "CHECKOUT_TERMS_VERSION"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
