{
  "name": "devtrust-domains",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev",
    "build": "turbo build",
    "lint": "turbo lint && eslint tests *.config.ts",
    "typecheck": "turbo typecheck && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @devtrust/database generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @devtrust/database migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @devtrust/database seed",
    "admin:bootstrap": "dotenv -e .env -- pnpm --filter @devtrust/database bootstrap",
    "registrar:verify": "dotenv -e .env -- pnpm --filter @devtrust/api registrar:verify"
  },
  "devDependencies": {
    "@devtrust/contracts": "workspace:^",
    "@devtrust/database": "workspace:^",
    "@nestjs/common": "11.2.7",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.0",
    "otplib": "12.0.1",
    "prettier": "^3.6.2",
    "reflect-metadata": "0.2.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "effect": "3.21.0",
      "deepmerge-ts": "8.0.0",
      "js-yaml@>=5.0.0 <5.4.1": "5.4.1"
    }
  }
}
