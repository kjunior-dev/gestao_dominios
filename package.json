{
  "name": "devtrust-domains",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @devtrust/database generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @devtrust/database migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @devtrust/database seed",
    "admin:bootstrap": "dotenv -e .env -- pnpm --filter @devtrust/database bootstrap"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.14.0",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.6.2",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.56.0",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3"
  }
}
